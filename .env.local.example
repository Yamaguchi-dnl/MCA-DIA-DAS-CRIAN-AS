# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...sua_chave_anon...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...sua_service_role_key...

# URL pública do site (usada nas meta tags Open Graph). Ex.: https://iap-barreirinha.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
